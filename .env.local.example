# Copy this file to .env.local for local testing with `vercel dev`.
# In production, set these same values in Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real .env.local file to git.

# Map these from the CSV Amazon gave you (Associates Central -> Creators API -> your app):
#   CSV column "Credential Id"  -> CREATORS_API_CLIENT_ID
#   CSV column "Secret"         -> CREATORS_API_CLIENT_SECRET
#   CSV column "Version"        -> CREATORS_API_VERSION
# The "Application" and "Application Id" columns are not needed here.

CREATORS_API_CLIENT_ID=paste_credential_id_here
CREATORS_API_CLIENT_SECRET=paste_secret_here

# India is grouped separately from the EU marketplaces in Amazon's Creators
# API — it shows as Version 3.3 in Associates Central. The 3.2 credential
# from your first CSV export is EU-only (UK/DE/FR/IT/ES) and CANNOT fetch
# live data for www.amazon.in. If you haven't generated a 3.3 credential yet,
# do that in Associates Central -> Creators API before setting this to 3.3 —
# otherwise leave it at 3.2 and point CREATORS_API_MARKETPLACE at an EU store
# instead (product data just won't be live for India until then).
CREATORS_API_VERSION=3.3
CREATORS_API_MARKETPLACE=www.amazon.in

# Your Associates tracking ID for amazon.in (from Associates Central ->
# Manage Tracking IDs). Assumed to be shoptell-21 based on your domain —
# confirm this in Associates Central since -21 is also used by UK/Germany.
AMAZON_PARTNER_TAG=shoptell-21
